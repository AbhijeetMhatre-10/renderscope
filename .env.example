# Optional. PageSpeed Insights also accepts requests without a key, subject to quota.
VITE_PAGESPEED_API_KEY=
# Optional request timeout in milliseconds. Restart Vite after changing it.
VITE_PAGESPEED_TIMEOUT_MS=600000

# Optional server-side Gemini key used by Vite's /api/ai proxy middleware (never exposed to the browser).
# Leave empty to use RenderScope's built-in structured fallback analyzer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional production AI proxy endpoint (defaults to /api/ai).
VITE_AI_ENDPOINT=/api/ai